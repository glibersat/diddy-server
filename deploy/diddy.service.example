# Runs the Diddy server as a persistent systemd service, bound to loopback only (nginx,
# see deploy/nginx.conf.example, is what's actually reachable from the internet).
#
# Setup:
#   1. Edit User/WorkingDirectory/paths below for your host.
#   2. sudo cp deploy/diddy.service.example /etc/systemd/system/diddy.service
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now diddy
#   4. journalctl -u diddy -f   # logs

[Unit]
Description=Diddy notification server
After=network.target

[Service]
Type=simple
User=diddy
WorkingDirectory=/opt/diddy/server
EnvironmentFile=/opt/diddy/server/.env
ExecStart=/opt/diddy/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
