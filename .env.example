DIDDY_DATABASE_URL=sqlite:///./diddy.db
DIDDY_DEFAULT_TIMEZONE=UTC

DIDDY_DAILY_TICK_SECONDS=60
DIDDY_ICS_REFRESH_SECONDS=300
DIDDY_DISPATCH_TICK_SECONDS=30

DIDDY_ACK_TIMEOUT_SECONDS=300
DIDDY_DELIVERY_TIMEOUT_SECONDS=60
DIDDY_MAX_SEND_ATTEMPTS=5

# Optional: message wearers via Signal alongside the watch trigger - see app/notify/signal.py
# and `uv run diddy-signal --help`. Leave unset to disable Signal messaging entirely.
# DIDDY_SIGNAL_ACCOUNT=+15551234567
# DIDDY_SIGNAL_CLI_BIN=signal-cli
# DIDDY_SIGNAL_CLI_CONFIG_DIR=
