DIDDY_DATABASE_URL=sqlite:///./diddy.db
DIDDY_DEFAULT_TIMEZONE=UTC

DIDDY_DAILY_TICK_SECONDS=60
DIDDY_ICS_REFRESH_SECONDS=60
DIDDY_DISPATCH_TICK_SECONDS=30

DIDDY_ACK_TIMEOUT_SECONDS=300
DIDDY_DELIVERY_TIMEOUT_SECONDS=60
DIDDY_MAX_SEND_ATTEMPTS=5
DIDDY_NOTIFICATION_TTL_HOURS=24
DIDDY_WS_SEND_TIMEOUT_SECONDS=5

# Allow ICS/CalDAV URLs on loopback/private/link-local addresses (self-hosted LAN calendars).
# Off by default: otherwise any user can make the server fetch from its internal network.
DIDDY_ALLOW_PRIVATE_FEED_URLS=false
